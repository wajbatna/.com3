rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Wajbatna - Hardened Firestore Rules
    //
    // IMPORTANT:
    // Security-sensitive operations are intentionally NOT writable
    // by the browser:
    //   - pointsLog
    //   - members
    //   - redemptions
    //   - reward/account counters
    //   - orders
    //
    // These operations must be performed by trusted server code
    // (Cloud Functions / Admin SDK).
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ------------------------------------------------------------
    // ADMINS
    // ------------------------------------------------------------
    match /admins/{uid} {
      allow get: if owner(uid) || admin();
      allow list, create, update, delete: if false;
    }

    // ------------------------------------------------------------
    // MEALS
    // ------------------------------------------------------------
    function validMeal(d) {
      return d.keys().hasOnly([
          'name', 'category', 'price', 'description', 'image'
        ])
        && d.name is string
        && d.name.size() >= 1
        && d.name.size() <= 200
        && d.category in ['breakfast', 'lunch', 'dinner']
        && d.price is number
        && d.price >= 0
        && d.price <= 1000000
        && d.get('description', '') is string
        && d.get('description', '').size() <= 5000
        && d.get('image', '') is string
        && d.get('image', '').size() <= 500000;
    }

    match /meals/{mealId} {
      allow read: if true;
      allow create, update: if admin() && validMeal(request.resource.data);
      allow delete: if admin();
    }

    // ------------------------------------------------------------
    // CONFIG
    // ------------------------------------------------------------
    function validPointsNumber(v) {
      return v is number && v >= 0 && v <= 100000;
    }

    function validPointsRules(d) {
      return d.keys().hasOnly([
          'firstOrderPoints',
          'perDirham',
          'reviewPoints',
          'referralPoints',
          'streak3Bonus',
          'monthly5Bonus',
          'monthly10Bonus'
        ])
        && validPointsNumber(d.firstOrderPoints)
        && d.perDirham is number
        && d.perDirham > 0
        && d.perDirham <= 100000
        && validPointsNumber(d.reviewPoints)
        && validPointsNumber(d.referralPoints)
        && validPointsNumber(d.streak3Bonus)
        && validPointsNumber(d.monthly5Bonus)
        && validPointsNumber(d.monthly10Bonus);
    }

    function validPaymentMethod(m) {
      return m == null
        || (
          m is map
          && m.keys().hasOnly(['enabled', 'rib', 'holder', 'note'])
          && m.get('enabled', true) is bool
          && m.get('rib', '') is string
          && m.get('rib', '').size() <= 200
          && m.get('holder', '') is string
          && m.get('holder', '').size() <= 200
          && m.get('note', '') is string
          && m.get('note', '').size() <= 1000
        );
    }

    function validPaymentMethods(d) {
      return d.keys().size() <= 30
        && validPaymentMethod(d.get('card', null))
        && validPaymentMethod(d.get('cod', null))
        && validPaymentMethod(d.get('tpe', null))
        && validPaymentMethod(d.get('cih', null))
        && validPaymentMethod(d.get('fellah', null))
        && validPaymentMethod(d.get('cashplus', null))
        && validPaymentMethod(d.get('wafacash', null))
        && validPaymentMethod(d.get('tijari', null))
        && validPaymentMethod(d.get('baridbank', null));
    }

    function validConfig(id, d) {
      return
        (id == 'dailyMeal'
          && d.keys().hasOnly(['image'])
          && d.image is string
          && d.image.size() <= 500000)
        ||
        (id == 'pointsRules' && validPointsRules(d))
        ||
        (id == 'paymentMethods' && validPaymentMethods(d));
    }

    match /config/{docId} {
      allow get: if docId in [
        'dailyMeal', 'paymentMethods', 'pointsRules'
      ];

      allow read: if admin();

      allow create, update:
        if admin() && validConfig(docId, request.resource.data);

      allow delete: if false;
    }

    // ------------------------------------------------------------
    // REWARDS
    // ------------------------------------------------------------
    function validReward(d) {
      return d.keys().hasOnly([
          'name', 'pointsCost', 'description', 'active'
        ])
        && d.name is string
        && d.name.size() >= 1
        && d.name.size() <= 200
        && d.pointsCost is number
        && d.pointsCost > 0
        && d.pointsCost <= 100000
        && d.get('description', '') is string
        && d.get('description', '').size() <= 2000
        && d.get('active', true) is bool;
    }

    match /rewards/{rewardId} {
      allow read:
        if admin()
        || (signedIn() && resource.data.active == true);

      allow create, update:
        if admin() && validReward(request.resource.data);

      allow delete: if admin();
    }

    // ------------------------------------------------------------
    // ORDERS
    // ------------------------------------------------------------
    //
    // The browser MUST NOT create orders directly.
    //
    // Reason:
    // Firestore Rules cannot safely calculate an arbitrary cart total
    // from a client-supplied list of meal IDs/quantities/prices.
    //
    // A trusted Cloud Function should:
    // 1. read current meal prices;
    // 2. validate quantities;
    // 3. calculate the total;
    // 4. create the order;
    // 5. award points;
    // 6. update counters/membership atomically where appropriate.
    //
    function validOrderCustomer(c) {
      return c is map
        && c.keys().hasOnly([
          'name', 'phone', 'address', 'mapLink', 'notes'
        ])
        && c.keys().hasAll([
          'name', 'phone', 'address', 'mapLink', 'notes'
        ])
        && c.name is string
        && c.name.size() >= 1
        && c.name.size() <= 200
        && c.phone is string
        && c.phone.matches(
          '^(0[5-7][0-9]{8}|[+]212[5-7][0-9]{8})$'
        )
        && c.address is string
        && c.address.size() >= 1
        && c.address.size() <= 1000
        && c.mapLink is string
        && (
          c.mapLink == ''
          || c.mapLink.matches(
            '^https://www[.]google[.]com/maps[?]q=[-0-9.,eE+]+$'
          )
        )
        && c.notes is string
        && c.notes.size() <= 2000;
    }

    function validOrderSchedule(s) {
      return s is map
        && s.keys().hasOnly([
          'dateFrom', 'dateTo', 'deliveryTime'
        ])
        && s.keys().hasAll([
          'dateFrom', 'dateTo', 'deliveryTime'
        ])
        && s.dateFrom is string
        && s.dateFrom.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && s.dateTo is string
        && s.dateTo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && s.dateTo >= s.dateFrom
        && s.deliveryTime is string
        && s.deliveryTime.matches(
          '^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$'
        );
    }

    function validOrder(d) {
      return d.keys().hasOnly([
          'uid',
          'customer',
          'schedule',
          'plan',
          'durationDays',
          'paymentMethod',
          'paymentMethodLabel',
          'deliveryLocation',
          'mealType',
          'lang',
          'items',
          'total',
          'status',
          'createdAt'
        ])
        && d.keys().hasAll([
          'uid',
          'customer',
          'schedule',
          'plan',
          'durationDays',
          'paymentMethod',
          'paymentMethodLabel',
          'deliveryLocation',
          'mealType',
          'lang',
          'items',
          'total',
          'status',
          'createdAt'
        ])
        && d.uid is string
        && validOrderCustomer(d.customer)
        && validOrderSchedule(d.schedule)
        && d.plan in ['daily', 'weekly', 'monthly']
        && d.durationDays is number
        && d.durationDays >= 1
        && d.durationDays <= 3650
        && d.paymentMethod in [
          'card', 'cod', 'tpe', 'cih', 'fellah',
          'cashplus', 'wafacash', 'tijari', 'baridbank'
        ]
        && d.paymentMethodLabel is string
        && d.paymentMethodLabel.size() <= 200
        && d.deliveryLocation in ['home', 'work']
        && d.mealType in ['lunch', 'dinner']
        && d.lang in ['ar', 'fr']
        && d.items is list
        && d.items.size() >= 1
        && d.items.size() <= 100
        && d.total is number
        && d.total > 0
        && d.total <= 1000000
        && d.status == 'قيد المراجعة'
        && d.createdAt == request.time;
    }

    function canReviewOrder() {
      return signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               'reviewed',
               'rating',
               'reviewComment'
             ])
        && request.resource.data.reviewed == true
        && resource.data.get('reviewed', false) != true
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.reviewComment is string
        && request.resource.data.reviewComment.size() <= 1000;
    }

    match /orders/{orderId} {
      allow read:
        if admin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      // IMPORTANT: no direct client order creation.
      allow create: if false;

      allow update:
        if admin() || canReviewOrder();

      allow delete: if admin();
    }

    // ------------------------------------------------------------
    // USERS
    // ------------------------------------------------------------
    //
    // Client-editable profile fields are deliberately separated from
    // server-controlled counters and reward state.
    //
    function profileKeys() {
      return [
        'name',
        'address',
        'phone',
        'gender',
        'avatar'
      ];
    }

    function serverUserKeys() {
      return [
        'referralCode',
        'referredByUid',
        'referralBonusGiven',
        'orderCount',
        'ordersThisMonth',
        'lastOrderMonthKey',
        'orderMilestone3Given',
        'createdAt'
      ];
    }

    function validProfile(d) {
      return d.get('name', '') is string
        && d.get('name', '').size() <= 200
        && d.get('address', '') is string
        && d.get('address', '').size() <= 1000
        && d.get('phone', '') is string
        && d.get('phone', '').size() <= 20
        && d.get('gender', 'male') in ['male', 'female']
        && d.get('avatar', '') is string
        && d.get('avatar', '').size() <= 16;
    }

    function validUserCreate(d) {
      return d.keys().hasOnly(
          profileKeys().concat(serverUserKeys())
        )
        && validProfile(d)
        && d.get('referralCode', '') is string
        && d.get('referralCode', '').size() <= 12
        && (
          d.get('referredByUid', null) == null
          || (
            d.get('referredByUid', null) is string
            && d.get('referredByUid', null).size() <= 128
            && d.get('referredByUid', null) != request.auth.uid
          )
        )
        && d.get('referralBonusGiven', false) == false
        && d.get('orderCount', 0) == 0
        && d.get('ordersThisMonth', 0) == 0
        && d.get('lastOrderMonthKey', '') == ''
        && d.get('orderMilestone3Given', false) == false
        && d.get('createdAt', request.time) == request.time;
    }

    match /users/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();

      // Account creation is allowed only for the authenticated owner,
      // and all reward/counter fields are forced to their initial values.
      allow create:
        if owner(uid) && validUserCreate(request.resource.data);

      // Customer can edit only profile fields.
      // Counters/reward/referral state cannot be changed from the browser.
      allow update:
        if owner(uid)
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(profileKeys())
        && validProfile(request.resource.data);

      allow delete: if owner(uid);
    }

    // ------------------------------------------------------------
    // REFERRAL CODES
    // ------------------------------------------------------------
    match /referralCodes/{code} {
      allow get: if signedIn();

      allow create:
        if signedIn()
        && code.matches('^[A-Z0-9]{6}$')
        && request.auth.uid.upper().matches('^' + code + '.*')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;

      // A referral code must not be deleted/reassigned by a customer.
      allow delete, update, list: if false;
    }

    // ------------------------------------------------------------
    // MEMBERS
    // ------------------------------------------------------------
    //
    // Membership is derived from verified orders.
    // The browser must not create or extend membership.
    //
    match /members/{memberId} {
      allow get: if owner(memberId) || admin();
      allow list: if admin();

      allow create, update, delete: if admin();
    }

    // ------------------------------------------------------------
    // POINTS LOG
    // ------------------------------------------------------------
    //
    // NO CLIENT WRITES.
    //
    // This prevents:
    // - creating arbitrary positive points;
    // - creating arbitrary negative points;
    // - forging referral rewards;
    // - forging order rewards.
    //
    match /pointsLog/{logId} {
      allow read:
        if admin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create, update, delete: if admin();
    }

    // ------------------------------------------------------------
    // REDEMPTIONS
    // ------------------------------------------------------------
    //
    // NO CLIENT creation.
    // A trusted backend must atomically:
    // 1. verify the user's balance;
    // 2. verify reward price;
    // 3. create redemption;
    // 4. create negative pointsLog entry.
    //
    match /redemptions/{redemptionId} {
      allow read:
        if admin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create, update, delete: if admin();
    }

    // ------------------------------------------------------------
    // MESSAGES
    // ------------------------------------------------------------
    function validCustomerMessage(d) {
      return d.keys().hasOnly([
          'threadId',
          'senderUid',
          'senderRole',
          'text',
          'imageData',
          'readByCustomer',
          'readByAdmin',
          'createdAt'
        ])
        && d.keys().hasAll([
          'threadId',
          'senderUid',
          'senderRole',
          'text',
          'readByCustomer',
          'readByAdmin',
          'createdAt'
        ])
        && d.threadId == request.auth.uid
        && d.senderUid == request.auth.uid
        && d.senderRole == 'customer'
        && d.text is string
        && d.text.size() <= 2000
        && (
          !('imageData' in d)
          || (d.imageData is string && d.imageData.size() <= 1000000)
        )
        && d.readByCustomer == true
        && d.readByAdmin == false
        && d.createdAt == request.time;
    }

    function validAdminMessage(d) {
      return d.keys().hasOnly([
          'threadId',
          'senderUid',
          'senderRole',
          'text',
          'readByCustomer',
          'readByAdmin',
          'createdAt'
        ])
        && d.keys().hasAll([
          'threadId',
          'senderUid',
          'senderRole',
          'text',
          'readByCustomer',
          'readByAdmin',
          'createdAt'
        ])
        && d.threadId is string
        && d.threadId.size() > 0
        && d.threadId.size() <= 128
        && d.senderUid == request.auth.uid
        && d.senderRole == 'admin'
        && d.text is string
        && d.text.size() <= 2000
        && d.readByCustomer == false
        && d.readByAdmin == true
        && d.createdAt == request.time;
    }

    function customerMarksRead() {
      return signedIn()
        && resource.data.threadId == request.auth.uid
        && resource.data.senderRole == 'admin'
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['readByCustomer'])
        && request.resource.data.readByCustomer == true;
    }

    match /messages/{msgId} {
      allow read:
        if admin()
        || (signedIn() && resource.data.threadId == request.auth.uid);

      allow create:
        if signedIn()
        && (
          validCustomerMessage(request.resource.data)
          || (admin() && validAdminMessage(request.resource.data))
        );

      allow update:
        if customerMarksRead()
        || (
          admin()
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'readByAdmin',
                 'readByCustomer'
               ])
        );

      allow delete: if admin();
    }

    // ------------------------------------------------------------
    // DEFAULT DENY
    // ------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
